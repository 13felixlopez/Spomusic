        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
        <Border
            Grid.Row="0"
            Margin="16,12,16,0"
            Padding="15,0"
            BackgroundColor="{StaticResource SpotifySurfaceElevated}"
            Stroke="{StaticResource SpotifyStroke}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <SearchBar
                x:Name="LibrarySearchBar"
                BackgroundColor="Transparent"
                Placeholder="Buscar música..."
                Text="{Binding SearchText}"
                TextColor="White" />
        </Border>

        <Border
            x:Name="HomeLibraryHeroCard"
            Grid.Row="1"
            Margin="16,12,16,0"
            Padding="18"
            Stroke="{StaticResource SpotifyStroke}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{StaticResource SpotifyHeroTop}" />
                    <GradientStop Offset="1.0" Color="{StaticResource SpotifyHeroBottom}" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout
                x:Name="HomeLibraryHeroContent"
                HorizontalOptions="Fill"
                Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionEyebrowLabel}"
                        Text="SPOMUSIC LIBRARY" />
                    <HorizontalStackLayout
                        Grid.Column="1"
                        Spacing="8"
                        VerticalOptions="Center">
                        <ActivityIndicator
                            IsRunning="{Binding IsScanning}"
                            IsVisible="{Binding IsScanning}"
                            VerticalOptions="Center" />
                        <Border
                            Padding="8"
                            BackgroundColor="#18000000"
                            Stroke="#22FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleLibraryHeroClicked" />
                            </Border.GestureRecognizers>
                            <Path
                                x:Name="HomeLibraryHeroToggleIcon"
                                Aspect="Uniform"
                                Data="{StaticResource ChevronDownIcon}"
                                Fill="White"
                                HeightRequest="14"
                                Rotation="180"
                                WidthRequest="14" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
                <VerticalStackLayout
                    x:Name="HomeLibraryHeroHeader"
                    HorizontalOptions="Center"
                    Spacing="4">
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="NoWrap"
                        Style="{StaticResource SectionTitleLabel}"
                        Text="Tu Biblioteca" />
                    <Label
                        x:Name="HomeLibraryHeroSummary"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        Style="{StaticResource SectionBodyLabel}"
                        Text="{Binding LibrarySummary}" />
                </VerticalStackLayout>
                <Grid
                    x:Name="HomeLibraryHeroMetrics"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10">
                    <Border
                        Padding="12,10"
                        BackgroundColor="#18000000"
                        Stroke="#22FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource MetricValueLabel}" Text="{Binding TotalSongs}" />
                            <Label Style="{StaticResource MetricCaptionLabel}" Text="Canciones" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="12,10"
                        BackgroundColor="#18000000"
                        Stroke="#22FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource MetricValueLabel}" Text="{Binding ArtistCount}" />
                            <Label Style="{StaticResource MetricCaptionLabel}" Text="Artistas" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="12,10"
                        BackgroundColor="#18000000"
                        Stroke="#22FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource MetricValueLabel}" Text="{Binding FavoriteSongsCount}" />
                            <Label Style="{StaticResource MetricCaptionLabel}" Text="Favoritas" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <HorizontalStackLayout x:Name="HomeLibraryHeroActionRow" HorizontalOptions="End">
                    <Border
                        Padding="12,8"
                        BackgroundColor="#1AA34A"
                        Stroke="#26FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartRandomClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource ShuffleIcon}"
                                Fill="Black"
                                HeightRequest="14"
                                WidthRequest="14" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Aleatorio"
                                TextColor="Black"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid
            Grid.Row="2"
            Margin="16,14,16,0"
            RowDefinitions="*">
            <CollectionView
                x:Name="SongListView"
                Grid.Row="0"
                Margin="0,0,0,0"
                ItemsSource="{Binding FilteredSongs}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="14"
                        VerticalOptions="Center">
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource MusicBrandLogo}"
                            Fill="{StaticResource SpotifyLightGray}"
                            HeightRequest="100"
                            Opacity="0.5"
                            WidthRequest="100" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionTitleLabel}"
                            Text="Sin resultados" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionBodyLabel}"
                            Text="{Binding LibrarySummary}" />
                        <Button
                            BackgroundColor="{StaticResource SpotifyGreen}"
                            Command="{Binding LoadSongsAsyncCommand}"
                            Text="Sincronizar" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SongItem">
                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            BackgroundColor="{StaticResource SpotifySurface}"
                            Stroke="{StaticResource SpotifyStroke}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="60, *, Auto, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border
                                    BackgroundColor="{StaticResource SpotifySurfaceAlt}"
                                    HeightRequest="56"
                                    Stroke="Transparent"
                                    WidthRequest="56">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Path
                                            Margin="12"
                                            Aspect="Uniform"
                                            Data="{StaticResource MusicBrandLogo}"
                                            Fill="#444" />
                                        <Image Aspect="AspectFill" Source="{Binding AlbumArt, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Margin="15,0"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        MaxLines="1"
                                        Text="{Binding Title}"
                                        TextColor="White" />
                                    <Label
                                        FontSize="13"
                                        MaxLines="1"
                                        Text="{Binding Artist}"
                                        TextColor="{StaticResource SpotifyLightGray}" />
                                    <Label
                                        FontSize="11"
                                        MaxLines="1"
                                        Text="{Binding Album}"
                                        TextColor="#6FC28D" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Padding="10"
                                    BackgroundColor="#12000000"
                                    Stroke="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleFavoriteCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource HeartOutline}"
                                        Fill="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}">
                                        <Path.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFavorite}"
                                                TargetType="Path"
                                                Value="True">
                                                <Setter Property="Data" Value="{StaticResource HeartSolid}" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Border>
                                <Border
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Padding="10"
                                    BackgroundColor="#12000000"
                                    Stroke="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSongPlaylistClicked" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource PlaylistAddIcon}"
                                        Fill="#D9FDE5" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="12,6,12,6"
            Padding="10,6"
            BackgroundColor="#1C242B"
            IsVisible="{Binding CurrentSong, Converter={StaticResource IsNotNullConverter}}"
            Stroke="#3300F59B">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#222C33" />
                    <GradientStop Offset="1.0" Color="#131B20" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="46, *, Auto, Auto" ColumnSpacing="12">
                <Border
                    BackgroundColor="#2A353D"
                    HeightRequest="46"
                    Stroke="#33FFFFFF"
                    WidthRequest="46">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid>
                        <Path
                            Margin="10"
                            Aspect="Uniform"
                            Data="{StaticResource MusicBrandLogo}"
                            Fill="#00F59B"
                            Opacity="0.4" />
                        <Image Aspect="AspectFill" Source="{Binding CurrentSong.AlbumArt, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding CurrentSong.Title}"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding CurrentSong.Artist}"
                        TextColor="#9EC0B4" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <Border
                    Grid.Column="2"
                    Padding="10"
                    BackgroundColor="#00F59B"
                    HeightRequest="40"
                    Stroke="Transparent"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource PlayIcon}"
                            Fill="#080C0E"
                            HeightRequest="16"
                            IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}}"
                            WidthRequest="16" />
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource PauseIcon}"
                            Fill="#080C0E"
                            HeightRequest="16"
                            IsVisible="{Binding IsPlaying}"
                            WidthRequest="16" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Padding="10"
                    BackgroundColor="#1F2A30"
                    HeightRequest="40"
                    Stroke="#22FFFFFF"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StopPlaybackCommand}" />
                    </Border.GestureRecognizers>
                    <Path
                        Aspect="Uniform"
                        Data="{StaticResource StopIcon}"
                        Fill="#C5D3D9"
                        HeightRequest="14"
                        WidthRequest="14" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Margin="12,0,12,12"
            Padding="4,6"
            BackgroundColor="#141C22"
            Stroke="#223B47">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#182229" />
                    <GradientStop Offset="1.0" Color="#0D1418" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <!-- Search Button -->
                <Border
                    Grid.Column="0"
                    Padding="4,6"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFocusSearchClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource SearchIcon}"
                            Fill="#A0B8C4"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            WidthRequest="18" />
                        <Label
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="Buscar"
                            TextColor="#A0B8C4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Playlists Button -->
                <Border
                    Grid.Column="1"
                    Padding="4,6"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlaylistPanelCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource PlaylistMusicIcon}"
                            Fill="#A0B8C4"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            WidthRequest="18" />
                        <Label
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="Playlists"
                            TextColor="#A0B8C4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Folders Button -->
                <Border
                    Grid.Column="2"
                    Padding="4,6"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFolderPanelCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource FolderMusicIcon}"
                            Fill="#A0B8C4"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            WidthRequest="18" />
                        <Label
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="Carpetas"
                            TextColor="#A0B8C4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Discover Button -->
                <Border
                    Grid.Column="3"
                    Padding="4,6"
                    BackgroundColor="#1F362C"
                    Stroke="#3300F59B">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDiscoverPanelCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource CompassIcon}"
                            Fill="#00F59B"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            WidthRequest="18" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="Descubrir"
                            TextColor="#00F59B" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="FullPlayerOverlay"
            Grid.RowSpan="5"
            IsVisible="False"
            TranslationY="1000">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="{Binding CurrentSong.AccentColorHex, Converter={StaticResource HexColorConverter}}" />
                    <GradientStop Offset="0.9" Color="#121212" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollView Grid.RowSpan="4">
                <VerticalStackLayout Spacing="0">
                    <Grid Margin="15,42,15,0" ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                        <Border
                            Padding="15"
                            HeightRequest="50"
                            Stroke="Transparent"
                            WidthRequest="50">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseFullPlayerClicked" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource ChevronDownIcon}"
                                Fill="White" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                CharacterSpacing="2"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="REPRODUCIENDO"
                                TextColor="#D7E7DC" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                MaxLines="1"
                                Text="{Binding ActivePlaylist.Name, TargetNullValue=Tu biblioteca}"
                                TextColor="White" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="10"
                            HeightRequest="38"
                            Stroke="Transparent"
                            WidthRequest="38">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareSongCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource ShareIcon}"
                                Fill="White" />
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="10"
                            HeightRequest="38"
                            Stroke="Transparent"
                            WidthRequest="38">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleQueuePanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource QueueIcon}"
                                Fill="White" />
                        </Border>
                    </Grid>

                    <Border
                        x:Name="FullPlayerArtwork"
                        Margin="32,28,32,0"
                        HeightRequest="320"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        VerticalOptions="Start"
                        WidthRequest="320">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <!--
                                Lower threshold keeps artwork swipes responsive even after the
                                full-screen vertical scroll was introduced for the player.
                            -->
                            <SwipeGestureRecognizer
                                Command="{Binding NextCommand}"
                                Direction="Left"
                                Threshold="32" />
                            <SwipeGestureRecognizer
                                Command="{Binding PreviousCommand}"
                                Direction="Right"
                                Threshold="32" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <BoxView Color="{StaticResource SpotifyGray}" />
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource MusicBrandLogo}"
                                Fill="#333"
                                Scale="2.5" />
                            <Image Aspect="AspectFill" Source="{Binding CurrentSong.AlbumArt, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="FullPlayerMetadataRow"
                        Margin="28,18,22,0"
                        ColumnDefinitions="*, Auto"
                        ColumnSpacing="16"
                        IsVisible="{Binding IsNotFocusMode}">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <ScrollView
                                x:Name="FullPlayerTitleScroller"
                                HorizontalScrollBarVisibility="Never"
                                Orientation="Horizontal">
                                <Label
                                    x:Name="FullPlayerTitleLabel"
                                    FontAttributes="Bold"
                                    FontSize="26"
                                    LineBreakMode="NoWrap"
                                    TextColor="White" />
                            </ScrollView>
                            <ScrollView
                                x:Name="FullPlayerArtistScroller"
                                HorizontalScrollBarVisibility="Never"
                                Orientation="Horizontal">
                                <Label
                                    x:Name="FullPlayerArtistLabel"
                                    FontSize="18"
                                    LineBreakMode="NoWrap"
                                    TextColor="{StaticResource SpotifyLightGray}" />
                            </ScrollView>
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="End"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Border
                                Padding="10"
                                Stroke="Transparent"
                                WidthRequest="40">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentSong}" />
                                </Border.GestureRecognizers>
                                <Path
                                    Aspect="Uniform"
                                    Data="{StaticResource HeartOutline}"
                                    Fill="{Binding CurrentSong.IsFavorite, Converter={StaticResource FavoriteColorConverter}}">
                                    <Path.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CurrentSong.IsFavorite}"
                                            TargetType="Path"
                                            Value="True">
                                            <Setter Property="Data" Value="{StaticResource HeartSolid}" />
                                        </DataTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Margin="28,20,28,18">
                        <VerticalStackLayout Spacing="20">
                            <VerticalStackLayout IsVisible="{Binding IsNotFocusMode}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                    <Border
                                        Padding="8"
                                        BackgroundColor="#1CFFFFFF"
                                        Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSleepTimerClicked" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="Dormir"
                                            TextColor="White" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding SleepTimerStatus}"
                                        TextColor="{StaticResource SpotifyLightGray}"
                                        VerticalOptions="Center" />
                                    <Border
                                        Grid.Column="2"
                                        Padding="8"
                                        BackgroundColor="#15000000"
                                        Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnQuickSleep15Clicked" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="15"
                                            TextColor="White" />
                                    </Border>
                                    <Border
                                        Grid.Column="3"
                                        Padding="8"
                                        BackgroundColor="#15000000"
                                        Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnQuickSleep30Clicked" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="30"
                                            TextColor="White" />
                                    </Border>
                                    <Border
                                        Grid.Column="4"
                                        Padding="8"
                                        BackgroundColor="#15000000"
                                        Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnQuickSleep60Clicked" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="60"
                                            TextColor="White" />
                                    </Border>
                                    <Border
                                        Grid.Column="5"
                                        Padding="8"
                                        BackgroundColor="#15000000"
                                        IsVisible="{Binding HasSleepTimer}"
                                        Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCancelSleepTimerClicked" />
                                        </Border.GestureRecognizers>
                                        <Path
                                            Aspect="Uniform"
                                            Data="{StaticResource CloseIcon}"
                                            Fill="White"
                                            HeightRequest="12"
                                            WidthRequest="12" />
                                    </Border>
                                </Grid>
                                <Slider
                                    DragCompleted="OnSliderDragCompleted"
                                    Maximum="{Binding Duration}"
                                    MaximumTrackColor="#333333"
                                    MinimumTrackColor="{StaticResource SpotifyGreen}"
                                    ThumbColor="White"
                                    Value="{Binding CurrentPosition}" />
                                <Grid ColumnDefinitions="*, *">
                                    <Label
                                        FontSize="12"
                                        Text="{Binding CurrentPosition, Converter={StaticResource TimeSecondsConverter}}"
                                        TextColor="{StaticResource SpotifyLightGray}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        HorizontalOptions="End"
                                        Text="{Binding Duration, Converter={StaticResource TimeSecondsConverter}}"
                                        TextColor="{StaticResource SpotifyLightGray}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Grid
                                ColumnDefinitions="*,*,1.4*,*,*,*"
                                ColumnSpacing="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                                <Border
                                    Grid.Column="0"
                                    Padding="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsNotFocusMode}"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleShuffleCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource ShuffleIcon}"
                                        Fill="{Binding IsShuffle, Converter={StaticResource ShuffleColorConverter}}" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Center"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource PrevIcon}"
                                        Fill="White" />
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="20"
                                    BackgroundColor="White"
                                    HeightRequest="72"
                                    HorizontalOptions="Center"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="36" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <Path
                                            Aspect="Uniform"
                                            Data="{StaticResource PlayIcon}"
                                            Fill="Black"
                                            IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}}" />
                                        <Path
                                            Aspect="Uniform"
                                            Data="{StaticResource PauseIcon}"
                                            Fill="Black"
                                            IsVisible="{Binding IsPlaying}" />
                                    </Grid>
                                </Border>
                                <Border
                                    Grid.Column="3"
                                    Padding="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Center"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NextCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource NextIcon}"
                                        Fill="White" />
                                </Border>
                                <Border
                                    Grid.Column="4"
                                    Padding="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsNotFocusMode}"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleRepeatCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <Path
                                            Aspect="Uniform"
                                            Data="{StaticResource RepeatIcon}"
                                            Fill="{Binding RepeatMode, Converter={StaticResource RepeatColorConverter}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding RepeatMode, Converter={StaticResource IsRepeatOneConverter}}"
                                            Text="1"
                                            TextColor="{StaticResource SpotifyGreen}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <Border
                                    Grid.Column="5"
                                    Padding="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsNotFocusMode}"
                                    Stroke="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding StopPlaybackCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path
                                        Aspect="Uniform"
                                        Data="{StaticResource StopIcon}"
                                        Fill="White" />
                                </Border>
                            </Grid>

                            <Border
                                Margin="0,0,0,0"
                                Padding="16,14"
                                BackgroundColor="#1AFFFFFF"
                                HeightRequest="104"
                                Stroke="#22FFFFFF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleLyricsFullScreenCommand}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="LETRA"
                                            TextColor="White" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,3"
                                            BackgroundColor="#16000000"
                                            Stroke="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                Text="{Binding LyricSyncQuality, StringFormat='{}SYNC {0}'}"
                                                TextColor="{Binding LyricSyncQualityColor}" />
                                        </Border>
                                        <Border
                                            Grid.Column="3"
                                            Padding="6,2"
                                            BackgroundColor="#12000000"
                                            Stroke="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label
                                                    FontSize="10"
                                                    Text="{Binding CurrentLyricOffsetMs, StringFormat='{}{0}ms'}"
                                                    TextColor="#D7E7DC"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Padding="8"
                                            BackgroundColor="#16000000"
                                            HeightRequest="34"
                                            Stroke="Transparent"
                                            WidthRequest="34">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding DownloadLyricsCommand}" />
                                            </Border.GestureRecognizers>
                                            <Path
                                                Aspect="Uniform"
                                                Data="{StaticResource DownloadIcon}"
                                                Fill="White"
                                                HeightRequest="14"
                                                WidthRequest="14" />
                                        </Border>
                                        <Path
                                            Grid.Column="4"
                                            Aspect="Uniform"
                                            Data="{StaticResource ChevronDownIcon}"
                                            Fill="White"
                                            HeightRequest="14"
                                            Rotation="270"
                                            WidthRequest="14" />
                                    </Grid>
                                    <ScrollView
                                        Grid.Row="1"
                                        Orientation="Vertical"
                                        VerticalScrollBarVisibility="Never">
                                        <VerticalStackLayout Spacing="6">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                MaxLines="2"
                                                Text="{Binding CurrentLyricLine}"
                                                TextColor="White" />
                                            <Label
                                                FontSize="12"
                                                Text="Toca para abrir la letra completa"
                                                TextColor="#B7CBC0" />
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ==================== FOLDERS FULL-SCREEN PAGE ==================== -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsFolderPanelOpen}" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border
                Margin="0"
                Padding="20,44,20,20"
                BackgroundColor="#0C1216"
                HorizontalOptions="Fill"
                Stroke="Transparent"
                VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#16222B" />
                        <GradientStop Offset="0.4" Color="#0D1419" />
                        <GradientStop Offset="1.0" Color="#070A0D" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Page Header Bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border
                            Padding="11"
                            BackgroundColor="#1F2F39"
                            HeightRequest="44"
                            Stroke="#3300F59B"
                            WidthRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFolderPanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource BackIcon}"
                                Fill="#00F59B"
                                HeightRequest="18"
                                WidthRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1.5"
                                FontSize="11"
                                FontAttributes="Bold"
                                Text="EXPLORADOR DE ARCHIVOS"
                                TextColor="#00F59B" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="Carpetas de Música"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Grid.Row="1"
                        Margin="0,16,0,14"
                        FontSize="13"
                        Text="Selecciona las carpetas de tu dispositivo que quieres sincronizar e incluir en la biblioteca."
                        TextColor="#9AB4C2" />

                    <!-- Folders Collection -->
                    <CollectionView
                        Grid.Row="2"
                        ItemsSource="{Binding ScanFolders}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScanFolderItem">
                                <Border
                                    Margin="0,0,0,12"
                                    Padding="16,14"
                                    BackgroundColor="#152129"
                                    Stroke="#223C4A">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border
                                            Padding="12"
                                            BackgroundColor="#1E2F3B"
                                            HeightRequest="46"
                                            Stroke="Transparent"
                                            WidthRequest="46">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Path
                                                Aspect="Uniform"
                                                Data="{StaticResource FolderMusicIcon}"
                                                Fill="#00D2FF"
                                                HeightRequest="22"
                                                WidthRequest="22" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding DisplayName}"
                                                TextColor="White" />
                                            <Label
                                                FontSize="11"
                                                LineBreakMode="MiddleTruncation"
                                                MaxLines="1"
                                                Text="{Binding Path}"
                                                TextColor="#7A93A0" />
                                        </VerticalStackLayout>
                                        <Switch
                                            Grid.Column="2"
                                            IsToggled="{Binding IsSelected}"
                                            OnColor="#00F59B"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Rescan CTA Button -->
                    <Button
                        Grid.Row="3"
                        Margin="0,14,0,8"
                        BackgroundColor="#00F59B"
                        Command="{Binding SaveFolderSelectionAsyncCommand}"
                        CornerRadius="24"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="52"
                        Text="Guardar y Escanear Música"
                        TextColor="#070C0E" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== PLAYLISTS FULL-SCREEN PAGE ==================== -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsPlaylistPanelOpen}" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border
                Margin="0"
                Padding="20,44,20,20"
                BackgroundColor="#0C1216"
                HorizontalOptions="Fill"
                Stroke="Transparent"
                VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#18232B" />
                        <GradientStop Offset="0.4" Color="#0D1419" />
                        <GradientStop Offset="1.0" Color="#070A0D" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border
                            Padding="11"
                            BackgroundColor="#1F2F39"
                            HeightRequest="44"
                            Stroke="#33A855F7"
                            WidthRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePlaylistPanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource BackIcon}"
                                Fill="#A855F7"
                                HeightRequest="18"
                                WidthRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1.5"
                                FontSize="11"
                                FontAttributes="Bold"
                                Text="COLECCIÓN MUSICAL"
                                TextColor="#A855F7" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="Tus Playlists"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Grid.Row="1"
                        Margin="0,14,0,12"
                        FontSize="13"
                        Text="{Binding PlaylistSummary}"
                        TextColor="#9AB4C2" />

                    <!-- Actions Card -->
                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,16"
                        Padding="14"
                        BackgroundColor="#16222B"
                        Stroke="#2A3D4A">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                BackgroundColor="#A855F7"
                                Clicked="OnCreatePlaylistClicked"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="44"
                                Text="+ Nueva Playlist"
                                TextColor="White" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="#1E2F3B"
                                Clicked="OnPlayActivePlaylistClicked"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="44"
                                IsEnabled="{Binding ActivePlaylist, Converter={StaticResource IsNotNullConverter}}"
                                Text="Reproducir Lista"
                                TextColor="#00F59B" />
                        </Grid>
                    </Border>

                    <!-- Playlists and Active Playlist Songs -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,*">
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Listas Creadas"
                                TextColor="White" />
                            <CollectionView
                                HeightRequest="180"
                                ItemsSource="{Binding Playlists}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Playlist">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="14,12"
                                            BackgroundColor="#152129"
                                            Stroke="#223C4A">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlaylistSelected" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border
                                                    Padding="10"
                                                    BackgroundColor="#251F33"
                                                    HeightRequest="40"
                                                    Stroke="Transparent"
                                                    WidthRequest="40">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Path
                                                        Aspect="Uniform"
                                                        Data="{StaticResource PlaylistMusicIcon}"
                                                        Fill="#A855F7"
                                                        HeightRequest="18"
                                                        WidthRequest="18" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding Name}"
                                                        TextColor="White" />
                                                    <Label
                                                        FontSize="11"
                                                        Text="Toca para ver y reproducir canciones"
                                                        TextColor="#829CA8" />
                                                </VerticalStackLayout>
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="12,6"
                                                    BackgroundColor="#1D3328"
                                                    Stroke="#3300F59B"
                                                    VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        Text="Abrir"
                                                        TextColor="#00F59B" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- Active Songs List -->
                        <CollectionView
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            ItemsSource="{Binding ActivePlaylistSongs}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SongItem">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        BackgroundColor="#141E26"
                                        Stroke="#1D2E37">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border
                                                Padding="8"
                                                BackgroundColor="#1D3028"
                                                HeightRequest="32"
                                                Stroke="Transparent"
                                                WidthRequest="32">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Path
                                                    Aspect="Uniform"
                                                    Data="{StaticResource PlayIcon}"
                                                    Fill="#00F59B"
                                                    HeightRequest="14"
                                                    WidthRequest="14" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextColor="White" />
                                                <Label
                                                    FontSize="11"
                                                    MaxLines="1"
                                                    Text="{Binding Artist}"
                                                    TextColor="#87A0AD" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== DISCOVER FULL-SCREEN PAGE ==================== -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsDiscoverPanelOpen}" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border
                x:Name="DiscoverPanel"
                Margin="0"
                Padding="20,44,20,20"
                BackgroundColor="#0C1216"
                HorizontalOptions="Fill"
                Stroke="Transparent"
                VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#16222B" />
                        <GradientStop Offset="0.4" Color="#0D1419" />
                        <GradientStop Offset="1.0" Color="#070A0D" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border
                            Padding="11"
                            BackgroundColor="#1F2F39"
                            HeightRequest="44"
                            Stroke="#3300F59B"
                            WidthRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDiscoverPanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource BackIcon}"
                                Fill="#00F59B"
                                HeightRequest="18"
                                WidthRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1.5"
                                FontSize="11"
                                FontAttributes="Bold"
                                Text="RADAR MUSICAL"
                                TextColor="#00F59B" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="Descubrir Música"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Recommended Section -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Margin="0,20,0,16"
                        Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource SparkleIcon}"
                                Fill="#00D2FF"
                                HeightRequest="14"
                                WidthRequest="14" />
                            <Label
                                CharacterSpacing="1.2"
                                FontSize="12"
                                FontAttributes="Bold"
                                Text="RECOMENDADAS PARA TI"
                                TextColor="#00D2FF" />
                        </HorizontalStackLayout>
                        <CollectionView
                            HeightRequest="150"
                            ItemsLayout="HorizontalList"
                            ItemsSource="{Binding RecommendedSongs}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SongItem">
                                    <Border
                                        Margin="0,0,12,0"
                                        Padding="12"
                                        BackgroundColor="#16222B"
                                        Stroke="#223C4A"
                                        WidthRequest="180">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                                            <Border
                                                BackgroundColor="#24333D"
                                                HeightRequest="48"
                                                Stroke="Transparent"
                                                WidthRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <Path
                                                        Margin="10"
                                                        Aspect="Uniform"
                                                        Data="{StaticResource MusicBrandLogo}"
                                                        Fill="#00D2FF"
                                                        Opacity="0.4" />
                                                    <Image Aspect="AspectFill" Source="{Binding AlbumArt, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextColor="White" />
                                                <Label
                                                    FontSize="11"
                                                    MaxLines="1"
                                                    Text="{Binding Artist}"
                                                    TextColor="#87A1AF" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Continue Listening Section -->
                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <Label
                            CharacterSpacing="1.2"
                            FontSize="12"
                            FontAttributes="Bold"
                            Text="CONTINUAR ESCUCHANDO"
                            TextColor="#9AB4C2" />
                        <CollectionView ItemsSource="{Binding ContinueListeningSongs}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SongItem">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        BackgroundColor="#152129"
                                        Stroke="#223C4A">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                            <Border
                                                BackgroundColor="#24333D"
                                                HeightRequest="44"
                                                Stroke="Transparent"
                                                WidthRequest="44">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <Path
                                                        Margin="10"
                                                        Aspect="Uniform"
                                                        Data="{StaticResource MusicBrandLogo}"
                                                        Fill="#00F59B"
                                                        Opacity="0.4" />
                                                    <Image Aspect="AspectFill" Source="{Binding AlbumArt, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextColor="White" />
                                                <Label
                                                    FontSize="11"
                                                    MaxLines="1"
                                                    Text="{Binding Artist}"
                                                    TextColor="#87A1AF" />
                                            </VerticalStackLayout>
                                            <Border
                                                Grid.Column="2"
                                                Padding="8"
                                                BackgroundColor="#1D3328"
                                                HeightRequest="32"
                                                Stroke="Transparent"
                                                WidthRequest="32">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Path
                                                    Aspect="Uniform"
                                                    Data="{StaticResource PlayIcon}"
                                                    Fill="#00F59B"
                                                    HeightRequest="14"
                                                    WidthRequest="14" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== QUEUE FULL-SCREEN PAGE ==================== -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsQueuePanelOpen}" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border
                x:Name="QueuePanel"
                Margin="0"
                Padding="20,44,20,20"
                BackgroundColor="#0C1216"
                HorizontalOptions="Fill"
                Stroke="Transparent"
                VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#18232B" />
                        <GradientStop Offset="0.4" Color="#0D1419" />
                        <GradientStop Offset="1.0" Color="#070A0D" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border
                            Padding="11"
                            BackgroundColor="#1F2F39"
                            HeightRequest="44"
                            Stroke="#3300F59B"
                            WidthRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleQueuePanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Aspect="Uniform"
                                Data="{StaticResource BackIcon}"
                                Fill="#00F59B"
                                HeightRequest="18"
                                WidthRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1.5"
                                FontSize="11"
                                FontAttributes="Bold"
                                Text="REPRODUCIENDO AHORA"
                                TextColor="#00F59B" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="Cola de Reproducción"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Grid.Row="1"
                        Margin="0,14,0,12"
                        FontSize="12"
                        Text="Arrastra y suelta canciones para reorganizar el orden de la fila."
                        TextColor="#9AB4C2" />

                    <CollectionView
                        x:Name="QueueCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding QueueSongs}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SongItem">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14,12"
                                    BackgroundColor="#152129"
                                    Stroke="#223C4A">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <DragGestureRecognizer DragStarting="OnQueueItemDragStarting" />
                                        <DropGestureRecognizer AllowDrop="True" Drop="OnQueueItemDrop" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label
                                            FontSize="18"
                                            Text="⠿"
                                            TextColor="#00F59B"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                MaxLines="1"
                                                Text="{Binding Title}"
                                                TextColor="White" />
                                            <Label
                                                FontSize="11"
                                                MaxLines="1"
                                                Text="{Binding Artist}"
                                                TextColor="#87A1AF" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="2"
                                            Padding="8"
                                            BackgroundColor="#1D3328"
                                            HeightRequest="32"
                                            Stroke="Transparent"
                                            WidthRequest="32">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path
                                                Aspect="Uniform"
                                                Data="{StaticResource PlayIcon}"
                                                Fill="#00F59B"
                                                HeightRequest="14"
                                                WidthRequest="14" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="5" IsVisible="{Binding IsLyricsFullScreen}">
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Command="{Binding IncreaseLyricsFontSizeCommand}" Direction="Up" />
                <SwipeGestureRecognizer Command="{Binding DecreaseLyricsFontSizeCommand}" Direction="Down" />
                <SwipeGestureRecognizer Command="{Binding NextCommand}" Direction="Left" />
                <SwipeGestureRecognizer Command="{Binding PreviousCommand}" Direction="Right" />
                <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" NumberOfTapsRequired="2" />
            </Grid.GestureRecognizers>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="{Binding CurrentSong.AccentColorHex, Converter={StaticResource HexColorConverter}}" />
                    <GradientStop Offset="0.95" Color="#121212" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Margin="16,50,16,0"
                ColumnDefinitions="*,Auto"
                HeightRequest="50">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="LETRAS"
                    TextColor="#E8FFF1"
                    VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Border
                        Padding="8"
                        BackgroundColor="#30000000"
                        HeightRequest="50"
                        Stroke="Transparent"
                        WidthRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DownloadLyricsCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource DownloadIcon}"
                            Fill="White" />
                    </Border>
                    <Border
                        Padding="12"
                        BackgroundColor="#30000000"
                        HeightRequest="50"
                        Stroke="Transparent"
                        WidthRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSyncMenuClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="22"
                            HorizontalOptions="Center"
                            Text="⋮"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        Padding="12"
                        BackgroundColor="#30000000"
                        HeightRequest="50"
                        Stroke="Transparent"
                        WidthRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleLyricsFullScreenCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource CloseIcon}"
                            Fill="White" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <CollectionView
                x:Name="LyricsCollectionView"
                Grid.Row="1"
                Margin="22,16,22,12"
                ItemsSource="{Binding FullLyrics}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:LyricLine">
                        <Label
                            Margin="0,4"
                            FontAttributes="Bold"
                            FontSize="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=LyricsFontSize}"
                            HorizontalTextAlignment="Center"
                            LineHeight="1.18">
                            <Label.FormattedText>
                                <MultiBinding Converter="{StaticResource KaraokeLineFormattedMultiConverter}">
                                    <Binding Path="Text" />
                                    <Binding Path="Index" />
                                    <Binding Path="CurrentLyricIndex" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                    <Binding Path="CurrentLyricWordProgress" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                    <Binding Path="IsHighContrastLyrics" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                </MultiBinding>
                            </Label.FormattedText>
                            <Label.Opacity>
                                <MultiBinding Converter="{StaticResource LyricLineOpacityMultiConverter}">
                                    <Binding Path="Index" />
                                    <Binding Path="CurrentLyricIndex" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                    <Binding Path="IsHighContrastLyrics" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                </MultiBinding>
                            </Label.Opacity>
                            <Label.Scale>
                                <MultiBinding Converter="{StaticResource LyricLineScaleMultiConverter}">
                                    <Binding Path="Index" />
                                    <Binding Path="CurrentLyricIndex" Source="{RelativeSource AncestorType={x:Type vm:MainViewModel}}" />
                                </MultiBinding>
                            </Label.Scale>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border
                Grid.Row="2"
                Margin="16,0,16,26"
                Padding="10,8"
                BackgroundColor="#1A000000"
                Stroke="#28FFFFFF"
                ZIndex="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="Karaoke Pro"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="10"
                        HorizontalTextAlignment="End"
                        Text="{Binding LyricLeadMs, StringFormat='{}+{0} ms'}"
                        TextColor="#F3FFF6"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="10"
                        HorizontalTextAlignment="End"
                        Text="{Binding LyricSyncQuality, StringFormat='{}Sync {0}'}"
                        TextColor="{Binding LyricSyncQualityColor}"
                        VerticalOptions="Center" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,4,8,0"
                        Maximum="1200"
                        MaximumTrackColor="#66FFFFFF"
                        Minimum="0"
                        MinimumTrackColor="White"
                        ThumbColor="White"
                        Value="{Binding LyricLeadMs}" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        BackgroundColor="#28000000"
                        Command="{Binding DecreaseLyricsFontSizeCommand}"
                        CornerRadius="8"
                        FontSize="11"
                        HeightRequest="34"
                        Text="A-"
                        TextColor="White"
                        WidthRequest="44" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        BackgroundColor="#28000000"
                        Command="{Binding IncreaseLyricsFontSizeCommand}"
                        CornerRadius="8"
                        FontSize="11"
                        HeightRequest="34"
                        Text="A+"
                        TextColor="White"
                        WidthRequest="44" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        Margin="6,0,0,0"
                        BackgroundColor="#28000000"
                        Command="{Binding ToggleHighContrastLyricsCommand}"
                        CornerRadius="8"
                        FontSize="11"
                        HeightRequest="34"
                        Text="HC"
                        TextColor="White"
                        WidthRequest="48" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="5"
                        Margin="6,0,0,0"
                        BackgroundColor="#213629"
                        Command="{Binding TapSyncCommand}"
                        CornerRadius="8"
                        FontSize="11"
                        HeightRequest="34"
                        Text="Sync"
                        TextColor="#DDFDE8"
                        WidthRequest="56" />
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="6"
                        Margin="6,0,0,0"
                        Padding="10"
                        BackgroundColor="#28000000"
                        HeightRequest="34"
                        Stroke="Transparent"
                        WidthRequest="42">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteDownloadedLyricsCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Aspect="Uniform"
                            Data="{StaticResource TrashIcon}"
                            Fill="White"
                            HeightRequest="14"
                            WidthRequest="14" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
